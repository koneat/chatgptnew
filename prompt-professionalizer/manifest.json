{
  "manifest_version": 3,
  "name": "Prompt Professionalizer",
  "version": "0.4.0",
  "description": "P 按钮可自由拖动；支持站点的 Chrome 图标变绿，模型验证可用后输入框 P 变绿。",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://copilot.microsoft.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "https://poe.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Prompt Professionalizer 设置"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*",
        "https://poe.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "enhance-active-input": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "优化并替换当前输入框中的提示词"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html"
}
